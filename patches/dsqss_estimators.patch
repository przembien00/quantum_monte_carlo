diff --git a/src/dla/df.hpp b/src/dla/df.hpp
new file mode 100644
index 0000000..15d436a
--- /dev/null
+++ b/src/dla/df.hpp
@@ -0,0 +1,261 @@
+// DSQSS (Discrete Space Quantum Systems Solver)
+// Copyright (C) 2018- The University of Tokyo
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+// Real-space imaginary-time S^z S^z correlator.
+//
+// The stock way to reach C^zz(r, tau) in DSQSS is to measure the structure
+// factor S^zz(k, tau) and Fourier transform back. That costs O(N_site * N_k)
+// per time slice, and an exact back-transform needs the whole Brillouin zone
+// (N_k = N_site), so the measurement is O(N^2) and dominates every other cost
+// beyond a few hundred sites.
+//
+// This class measures the same quantity directly in real space, on the
+// displacement classes named in the displacement file:
+//
+//   C^zz(r, tau) = (1/N_r) sum_{(i,j) in r} (1/Ntau) sum_t mz_i(t) mz_j(t+tau)
+//
+// which is O(N_r * N_pairs * Ntau^2). With a handful of requested
+// displacements that is linear in the number of sites, and the Brillouin-zone
+// machinery is not needed at all.
+//
+// Results are reported as D<kind>t<itau>, alongside the CF entries.
+
+#ifndef SRC_DLA_DF_HPP_
+#define SRC_DLA_DF_HPP_
+
+#include <cstdio>
+#include <fstream>
+#include <sstream>
+#include <utility>
+#include <vector>
+
+#include "accumulator.hpp"
+#include "algorithm.hpp"
+#include "debug.hpp"
+#include "displacement.hpp"
+#include "lattice.hpp"
+#include "parameter.hpp"
+
+class DF {
+ private:
+  bool to_be_calc;
+  Lattice& LAT;
+  Displacement& DISP;
+  int nkinds;
+  int Ntau;
+  double dtau;
+
+  Accumulator SIGN;
+  std::vector<std::vector<Accumulator> > ACC;
+  std::vector<std::vector<Accumulator> > PHY;
+
+  // mz[site][time slice] for the current configuration.
+  std::vector<std::vector<double> > mz;
+  // pairs[kind] = the (i, j) site pairs belonging to that displacement.
+  std::vector<std::vector<std::pair<int, int> > > pairs;
+
+ public:
+  DF(Parameter const& param, Lattice& lat, Displacement& disp);
+  void setinit();
+  void measure(double sgn);
+  void setsummary();
+  void summary();
+#ifdef MULTI
+  void allreduce(MPI_Comm comm);
+#endif
+  void show(FILE*);
+
+  void save(std::ofstream& F) const;
+  void load(std::ifstream& F);
+
+  bool calculated() { return to_be_calc; }
+};
+
+DF::DF(Parameter const& param, Lattice& lat, Displacement& disp)
+    : to_be_calc(false),
+      LAT(lat),
+      DISP(disp),
+      nkinds(disp.nkinds),
+      Ntau(param.NTAU),
+      dtau(param.BETA / param.NTAU) {
+  AutoDebugDump("DF::DF");
+  if (!disp.defined) {
+    return;
+  }
+  to_be_calc = true;
+
+  SIGN.reset();
+  for (int i = 0; i < nkinds; i++) {
+    ACC.push_back(std::vector<Accumulator>(Ntau));
+    PHY.push_back(std::vector<Accumulator>(Ntau));
+    for (int it = 0; it < Ntau; it++) {
+      std::stringstream ss;
+      ss << "D" << i << "t" << it;
+      ACC[i][it].reset();
+      PHY[i][it].reset(ss.str());
+    }
+  }
+
+  // Invert the (i, j) -> kind map once, so measurement walks pairs directly.
+  pairs.resize(nkinds);
+  for (Displacement::IR_iterator it = DISP.IR.begin(); it != DISP.IR.end();
+       ++it) {
+    pairs[it->second].push_back(it->first);
+  }
+
+  mz.resize(LAT.NSITE, std::vector<double>(Ntau, 0.0));
+}
+
+inline void DF::setinit() {
+  if (!to_be_calc) {
+    return;
+  }
+  AutoDebugDump("DF::setinit");
+  SIGN.reset();
+  for (int i = 0; i < nkinds; i++)
+    for (int itau = 0; itau < Ntau; itau++) ACC[i][itau].reset();
+}
+
+void DF::measure(double sgn) {
+  if (!to_be_calc) {
+    return;
+  }
+  AutoDebugDump("DF::measure");
+
+  // Sample every worldline onto the uniform tau grid. Same discretization the
+  // structure factor uses, so the two agree where both are available.
+  for (int s = 0; s < LAT.NSITE; s++) {
+    Site& SITE = LAT.S(s);
+    SiteProperty& SP = SITE.Property();
+    Site::iterator p(SITE);
+
+    double bTri = 0.0;
+    double tau = 0.0;
+    int it = 0;
+
+    while (!(++p).atOrigin()) {
+      Segment& S = *p;
+      const double m = SP.XVALS[S.X()];
+      const double tTri = bTri + S.length();
+
+      while (it < Ntau && tau < tTri) {
+        mz[s][it] = m;
+        it++;
+        tau = it * dtau;
+      }
+      bTri = tTri;
+    }
+    // A worldline that ends fractionally short of the last grid point.
+    while (it < Ntau) {
+      mz[s][it] = mz[s][it - 1];
+      it++;
+    }
+  }
+
+  const double invNtau = 1.0 / Ntau;
+  SIGN.accumulate(sgn);
+
+  for (int ik = 0; ik < nkinds; ik++) {
+    const std::vector<std::pair<int, int> >& pk = pairs[ik];
+    const int npair = static_cast<int>(pk.size());
+    if (npair == 0) {
+      continue;
+    }
+    const double invpair = 1.0 / npair;
+    for (int it = 0; it < Ntau; it++) {
+      double DZT = 0.0;
+      for (int ip = 0; ip < npair; ip++) {
+        const std::vector<double>& mi = mz[pk[ip].first];
+        const std::vector<double>& mj = mz[pk[ip].second];
+        for (int tt = 0; tt < Ntau; tt++) {
+          DZT += mi[tt] * mj[(tt + it) % Ntau];
+        }
+      }
+      ACC[ik][it].accumulate(sgn * DZT * invNtau * invpair);
+    }
+  }
+}
+
+inline void DF::show(FILE* F) {
+  if (!to_be_calc) {
+    return;
+  }
+  AutoDebugDump("DF::show");
+  for (int i = 0; i < nkinds; i++) {
+    for (int it = 0; it < Ntau; it++) {
+      PHY[i][it].show(F, "R");
+    }
+    std::fprintf(F, "\n");
+  }
+}
+
+inline void DF::summary() {
+  if (!to_be_calc) {
+    return;
+  }
+  AutoDebugDump("DF::summary");
+  for (int i = 0; i < nkinds; i++)
+    for (int itau = 0; itau < Ntau; itau++) PHY[i][itau].average();
+}
+
+void DF::setsummary() {
+  if (!to_be_calc) {
+    return;
+  }
+  AutoDebugDump("DF::setsummary");
+  SIGN.average();
+  const double sgn = SIGN.mean();
+  if (sgn == 0.0) {
+    return;
+  }
+  const double invsign = 1.0 / sgn;
+  for (int ik = 0; ik < nkinds; ik++) {
+    for (int it = 0; it < Ntau; it++) {
+      ACC[ik][it].average();
+      PHY[ik][it].accumulate(invsign * ACC[ik][it].mean());
+    }
+  }
+}
+
+#ifdef MULTI
+void DF::allreduce(MPI_Comm comm) {
+  for (int ik = 0; ik < nkinds; ik++) {
+    for (int it = 0; it < Ntau; it++) {
+      PHY[ik][it].allreduce(comm);
+    }
+  }
+}
+#endif
+
+void DF::save(std::ofstream& F) const {
+  Serialize::save(F, SIGN);
+  Serialize::save(F, ACC);
+  Serialize::save(F, PHY);
+}
+
+void DF::load(std::ifstream& F) {
+  Serialize::load(F, SIGN);
+  Serialize::load(F, ACC);
+  const int NKINDS = ACC.size();
+  if (nkinds != NKINDS) {
+    std::cerr << "ERROR: nkinds is mismatched" << std::endl;
+    std::cerr << "       dispfile maybe changed." << std::endl;
+    exit(1);
+  }
+  Serialize::load(F, PHY);
+}
+
+#endif  // SRC_DLA_DF_HPP_
