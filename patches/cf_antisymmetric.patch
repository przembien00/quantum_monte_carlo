@@ -432,6 +432,12 @@ double Simulation::UP_ONESTEP(bool thermalized) {
 
   const int xinc = W.getXBEHIND();
 
+  // Worm-head operator type for this step: does the head raise (+1) or lower
+  // (-1) the spin across itself. Moving up, the traversed region below carries
+  // xinc and the segment ahead carries c_S.X(). Captured before the move,
+  // since both change as the head advances.
+  const int c_headtype = c_S.X() - xinc;
+
   // Using a std::vector is slightly slower (1~5%) than using a raw pointer
   // for some environment... X(
   UniformInterval* UI = new UniformInterval[NCI];
@@ -621,7 +627,7 @@ double Simulation::UP_ONESTEP(bool thermalized) {
 
